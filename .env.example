# tgloggerd configuration -- copy to .env and edit. docker-compose.yml loads
# this file into every service. .env is git-ignored because it holds secrets.
#
# Paths are relative to the repository root, which is the container's working
# directory (/workspace).

# ---------------------------------------------------------------------------
# Container user. The daemon and web containers run as this uid:gid so files
# they write to the bind mount are owned by you rather than root. Default to
# 1000:1000; set these to your own `id -u` / `id -g` if that is not you. (The
# mysql service is unaffected; it manages its own user.)
# ---------------------------------------------------------------------------
TG_UID=1000
TG_GID=1000

# ---------------------------------------------------------------------------
# MySQL server (the "mysql" service). On first start the official image creates
# the daemon's database and user from these; the init hook then adds the web
# database and its two restricted users. The hostname "mysql" is the service
# name on the compose network.
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=tgloggerd
MYSQL_USER=tgloggerd
MYSQL_PASSWORD=change_me_tgloggerd

# ---------------------------------------------------------------------------
# tgloggerd daemon
# ---------------------------------------------------------------------------
TG_API_ID=123456                              # from https://my.telegram.org
TG_API_HASH=0123456789abcdef0123456789abcdef  # from https://my.telegram.org
TG_DATA_DIR=data/users/main                   # TDLib session/data directory
# TG_LOG_FILE: path to a log file; leave empty (below) to log to stdout. Do not
# add an inline comment -- for an empty value the env_file parser would take the
# "# ..." text as the value.
TG_LOG_FILE=
TG_LOG_LEVEL=info                             # error | warning | info | debug
TG_DB_HOST=mysql                              # the mysql service
TG_DB_PORT=3306
TG_DB_USER=tgloggerd                          # matches MYSQL_USER
TG_DB_PASSWORD=change_me_tgloggerd            # matches MYSQL_PASSWORD
TG_DB_NAME=tgloggerd                          # matches MYSQL_DATABASE
TG_STORAGE_DIR=data/storage/files             # where downloaded files are stored
TG_ADMIN_POLL_INTERVAL=300                    # group-admin refresh interval (s); 0 disables
TG_ADMIN_POLL_BATCH=4                         # groups refreshed per poll tick

# ---------------------------------------------------------------------------
# Web interface (optional). Binds inside the container; the compose file
# publishes it on host port 8080. Put a TLS-terminating reverse proxy in front
# for production and set WEB_SECURE_COOKIE=1 (see web/README.web).
# ---------------------------------------------------------------------------
WEB_LISTEN_ADDR=0.0.0.0                        # 0.0.0.0 so the published port reaches it
WEB_LISTEN_PORT=8080
WEB_THREADS=4

# Read-only client over the logger's schema (GRANT SELECT ON tgloggerd.*).
WEB_DB_HOST=mysql
WEB_DB_PORT=3306
WEB_DB_RO_NAME=tgloggerd
WEB_DB_RO_USER=web_ro
WEB_DB_RO_PASSWORD=change_me_ro
WEB_DB_RO_CONNS=4

# Read-write client over the web app's own schema (accounts, audit).
WEB_DB_APP_NAME=tgloggerd_web
WEB_DB_APP_USER=web_app
WEB_DB_APP_PASSWORD=change_me_app
WEB_DB_APP_CONNS=2

# Sessions and login.
WEB_SESSION_TIMEOUT=43200                      # session idle timeout (s); 0 = never
WEB_SECURE_COOKIE=0                            # 1 needs HTTPS; keep 0 for plain-HTTP local use
WEB_LOGIN_MAX_ATTEMPTS=5                       # failed logins per (ip, username)...
WEB_LOGIN_WINDOW=900                           # ...within this many seconds

# Assets and storage.
WEB_TEMPLATE_DIR=web/views/templates
WEB_STATIC_DIR=web/static
WEB_STORAGE_DIR=data/storage/files             # MUST equal TG_STORAGE_DIR
