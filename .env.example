# tgloggerd configuration -- copy to .env and edit. docker-compose.yml loads
# this file into every service. .env is git-ignored because it holds secrets.
#
# Paths are relative to the repository root, which is the container's working
# directory (/workspace).

# ---------------------------------------------------------------------------
# Container user. The daemon and web containers run as this uid:gid so files
# they write to the bind mount are owned by you rather than root. Default to
# 1000:1000; set these to your own `id -u` / `id -g` if that is not you. (The
# mysql service is unaffected; it manages its own user.)
# ---------------------------------------------------------------------------
TG_UID=1000
TG_GID=1000

# ---------------------------------------------------------------------------
# MySQL server (the "mysql" service). On first start the official image creates
# the daemon's database and user from these; the init hook then adds the web
# database and its two restricted users. The hostname "mysql" is the service
# name on the compose network.
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=tgloggerd
MYSQL_USER=tgloggerd
MYSQL_PASSWORD=change_me_tgloggerd

# ---------------------------------------------------------------------------
# tgloggerd daemon
# ---------------------------------------------------------------------------
TG_API_ID=123456                              # from https://my.telegram.org
TG_API_HASH=0123456789abcdef0123456789abcdef  # from https://my.telegram.org
TG_DATA_DIR=data/users/main                   # TDLib session/data directory
# TG_LOG_FILE: path to a log file; leave empty (below) to log to stdout. Do not
# add an inline comment -- for an empty value the env_file parser would take the
# "# ..." text as the value.
TG_LOG_FILE=
TG_LOG_LEVEL=info                             # error | warning | info | debug
TG_DB_HOST=mysql                              # the mysql service
TG_DB_PORT=3306
TG_DB_USER=tgloggerd                          # matches MYSQL_USER
TG_DB_PASSWORD=change_me_tgloggerd            # matches MYSQL_PASSWORD
TG_DB_NAME=tgloggerd                          # matches MYSQL_DATABASE
TG_STORAGE_DIR=data/storage/files             # where downloaded files are stored
# TDLib downloads each file into its own store; tgloggerd keeps a second
# content-addressed copy under TG_STORAGE_DIR. These prune TDLib's redundant
# copy so files are not stored twice. Set to 0 to keep TDLib's cache.
TG_PRUNE_TDLIB_FILES=1                         # delete TDLib's copy after storing ours
TG_PRUNE_TDLIB_ON_START=1                      # optimizeStorage at boot to reclaim the backlog
# Cap on-disk storage: files at or above this size are downloaded and hashed
# but NOT copied into the store -- only their metadata (tg_file_id, sha256,
# size) is kept, so they stay re-downloadable by tg_file_id. 0 disables.
TG_MAX_STORE_FILE_SIZE=1073741824              # 1 GiB; files >= this are metadata-only
TG_ADMIN_POLL_INTERVAL=300                    # group-admin refresh interval (s); 0 disables
TG_ADMIN_POLL_BATCH=4                         # groups refreshed per poll tick
# Background message backfiller: walks every accessible chat's history
# newest->oldest, round-robin and gently paced, to collect messages the
# real-time path never saw. Resumes across restarts. Interval 0 disables it.
TG_BACKFILL_INTERVAL=3                         # seconds between history pages; 0 disables
TG_BACKFILL_DISCOVERY_INTERVAL=300             # seconds between chat-list discovery sweeps
TG_BACKFILL_PAGE=100                           # messages fetched per page (max 100)
TG_BACKFILL_INFLIGHT=1                         # max concurrent history requests

# ---------------------------------------------------------------------------
# Web interface (optional). Binds inside the container; the compose file
# publishes it on host port 8080. Put a TLS-terminating reverse proxy in front
# for production and set WEB_SECURE_COOKIE=1 (see web/README.web).
# ---------------------------------------------------------------------------
WEB_LISTEN_ADDR=0.0.0.0                        # 0.0.0.0 so the published port reaches it
WEB_LISTEN_PORT=8080
WEB_THREADS=4

# Read-only client over the logger's schema (GRANT SELECT ON tgloggerd.*).
WEB_DB_HOST=mysql
WEB_DB_PORT=3306
WEB_DB_RO_NAME=tgloggerd
WEB_DB_RO_USER=web_ro
WEB_DB_RO_PASSWORD=change_me_ro
WEB_DB_RO_CONNS=4

# Read-write client over the web app's own schema (accounts, audit).
WEB_DB_APP_NAME=tgloggerd_web
WEB_DB_APP_USER=web_app
WEB_DB_APP_PASSWORD=change_me_app
WEB_DB_APP_CONNS=2

# Sessions and login.
# Secret key that signs the stateless auth/CSRF cookies and encrypts the
# public /files/<token> URLs (base64-encoded).
# Generate one with: openssl rand -base64 32
# Keep it secret and stable: changing it invalidates every logged-in session.
WEB_APP_KEY=change_me_base64_32_random_bytes
WEB_SESSION_TIMEOUT=43200                      # session lifetime (s) from login; 0 = never
WEB_SECURE_COOKIE=0                            # 1 needs HTTPS; keep 0 for plain-HTTP local use
WEB_LOGIN_MAX_ATTEMPTS=5                       # failed logins per (ip, username)...
WEB_LOGIN_WINDOW=900                           # ...within this many seconds

# Assets and storage.
WEB_TEMPLATE_DIR=web/views/templates
WEB_STATIC_DIR=web/static
WEB_STORAGE_DIR=data/storage/files             # MUST equal TG_STORAGE_DIR

# ---------------------------------------------------------------------------
# Discord webhook forwarding (optional). Mirror a Telegram chat to a Discord
# channel; integrations are managed in the web UI at
# /platform-fwd/telegram-discord.
# ---------------------------------------------------------------------------
# Public base URL of the web app (no trailing slash). Forwarded avatars and
# media are posted as <this>/files/<token> links that Discord fetches, so it
# must be reachable from the internet (your reverse proxy's URL). Leave empty
# to forward text only (no avatars, no media). WEB_APP_KEY above mints the
# tokens, so the daemon and web must share it.
TG_DISCORD_PUBLIC_URL=
TG_DISCORD_THREADS=2                            # webhook POST workers
TG_DISCORD_QUEUE_MAX=20000                      # queued webhook posts before backpressure
TG_DISCORD_REFRESH_SECS=20                      # how often to reload the integrations table

# ---------------------------------------------------------------------------
# discordd -- the OTHER direction: log Discord messages and forward them to a
# Telegram group (the "discordd" compose service). Independent of the webhook
# forwarding above; you can run either, both, or neither.
#
# Routing is managed in the web UI at /platform-fwd/discord-telegram, or
# directly in the database: discord_telegram_routes maps
# a Discord channel to a Telegram chat, and references the sending bot's token
# in telegram_bots. Several channels can forward to different groups through
# different bots. Seed them with SQL, for example:
#
#   INSERT INTO telegram_bots (token) VALUES ('123456:ABC-your-bot-token');
#   INSERT INTO discord_telegram_routes
#          (discord_channel_id, telegram_chat_id, telegram_bot_id)
#   VALUES (1541156106343161896, -1001347566306, LAST_INSERT_ID());
#
# The Telegram bot must already be a member of the destination group.
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers. The bot needs the
# MESSAGE_CONTENT privileged intent enabled on its application page -- without
# it Discord closes the gateway with code 4014 and discordd exits rather than
# retrying (retrying would burn the daily IDENTIFY budget and get the token
# reset). It must also be a member of every channel you route from.
DISCORD_BOT_TOKEN=
# TDLib session directories for the sending bots, one subdirectory per bot.
DISCORDD_DATA_DIR=data/users/discordd
DISCORDD_LOG_LEVEL=info                         # error | warn | info | debug
DISCORDD_ROUTE_REFRESH_SECS=30                  # how often to reload the route table
DISCORDD_DB_CONNS=4
# discordd reuses TG_API_ID / TG_API_HASH above: TDLib requires an application
# id even for a bot session, so there is no second pair to obtain.

# ---------------------------------------------------------------------------
# MCP server (optional). Exposes the archive to a language model at /mcp.
#
# Two things gate it, both managed in the web UI under /mcp-admin: the groups
# it may read (nothing is readable until an admin adds one) and the bearer
# tokens that may ask. Neither lives here.
# ---------------------------------------------------------------------------
# Threads for running MCP tools. They use the blocking database API, so they
# get their own pool rather than an HTTP thread; a slow query then delays only
# another MCP call. Default 2, max 16.
MCP_THREADS=2
# Comma-separated browser origins allowed to call /mcp, or * for any. LEAVING
# THIS EMPTY ALLOWS ANY ORIGIN, which is the default on purpose: a bearer token
# is already required, and no CORS headers are ever sent, so a cross-origin page
# can neither authenticate nor read a response. Set it to pin the origins if you
# want the extra check -- and do set it if /mcp is ever exposed without a token.
MCP_ALLOWED_ORIGINS=
# Log the SHAPE of MCP requests (method, path, whether a credential and Origin
# were present -- never their values) to stderr. Off by default; useful when a
# client fails to connect and you need to see what it actually sent.
MCP_LOG_REQUESTS=0
